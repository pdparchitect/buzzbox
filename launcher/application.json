{
  "schemaVersion": 2,
  "id": "2784cf32-591a-4ba7-9c26-64ce6deeba55",
  "slug": "buzzbox",
  "name": "Buzzbox",
  "publisher": "PDP Architect",
  "description": "A browser-accessible Buzz workstation: the Buzz desktop client, a local relay with its own database and object store, and Codex, Claude Code, or Goose as the agent runtime.",
  "tags": [
    "DEVELOPMENT",
    "TERMINAL",
    "AUTONOMOUS"
  ],
  "media": {
    "icon": "icon.png",
    "cover": "screenshot.png",
    "screenshots": [
      {
        "source": "screenshot.png",
        "alt": "Buzz Desktop asking for an identity key on a fresh Buzzbox, with the local relay already running"
      }
    ]
  },
  "interfaces": {
    "desktop": {
      "kind": "kasmweb",
      "port": 6901,
      "path": "/"
    }
  },
  "memory": "6g",
  "sharedMemory": "1g",
  "environment": {
    "DESKTOP_VNC_STATS": "false"
  },
  "mounts": [
    {
      "name": "workspace",
      "target": "/workspace"
    },
    {
      "name": "private/services",
      "target": "/var/lib/buzzbox"
    },
    {
      "name": "private/buzz",
      "target": "/home/agent/.buzz"
    },
    {
      "name": "private/codex",
      "target": "/home/agent/.codex"
    },
    {
      "name": "private/claude",
      "target": "/home/agent/.claude"
    }
  ]
}
